# Pages live in folders (about/index.html, shop/index.html), so /about/ and
# /shop/ work on any server without rewrites. This file only redirects old
# .html links (bookmarks, Google results) to the new addresses.
RewriteEngine On

RewriteRule ^(about|shop)\.html$ /$1/ [R=301,L]
RewriteRule ^index\.html$ / [R=301,L]
